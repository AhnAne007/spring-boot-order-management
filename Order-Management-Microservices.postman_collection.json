    {
      "name": "04 - Circuit Breaker Demo",
      "description": "Stop RabbitMQ before Outage Order 1. After checking the OPEN state, restart RabbitMQ and wait before running the recovery probes.",
      "item": [
        {
          "name": "Outage Order 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{orderBaseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run only after executing: docker compose stop rabbitmq"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 503 while RabbitMQ is stopped', () => pm.response.to.have.status(503));",
                  "const json = pm.response.json();",
                  "pm.test('Error contains orderId', () => { pm.expect(json.error).to.be.a('string'); pm.expect(json.orderId).to.be.a('string'); });"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
