{
  "info": {
    "_postman_id": "cb01aee8-9101-4d7a-a85b-1f20df175a36",
    "name": "Order Management Microservices",
    "description": "Requests for validating the Product Service, Order Service, RabbitMQ flow, validation, and Resilience4j circuit breaker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "productBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "orderBaseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "initialStock",
      "value": "10"
    }
  ],
  "item": [
    {
      "name": "01 - Normal Flow",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{productBaseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rice\",\n  \"price\": 150.00,\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('productId', json.id);",
                  "pm.collectionVariables.set('initialStock', json.stock);",
                  "pm.test('Product fields are correct', () => { pm.expect(json.name).to.eql('Rice'); pm.expect(json.stock).to.eql(10); });"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "Get Product Before Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productBaseUrl}}/products/{{productId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Initial stock is 10', () => pm.expect(json.stock).to.eql(10));"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{orderBaseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "After this succeeds, wait about 2 seconds before running 'Get Product After Order' because stock consumption is asynchronous."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Order is PENDING', () => pm.expect(json.status).to.eql('PENDING'));",
                  "pm.test('Order quantity is 3', () => pm.expect(json.quantity).to.eql(3));",
                  "pm.collectionVariables.set('orderId', json.orderId);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "Get Product After Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productBaseUrl}}/products/{{productId}}",
            "description": "Run about 2 seconds after Create Order so Product Service has time to consume the message."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Stock reduced from 10 to 7', () => pm.expect(json.stock).to.eql(7));"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productBaseUrl}}/products"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        }
      ]
    },
