              ],
              "path": [
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":{{productId}},\"quantity\":3}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"testMode\") !== \"normal\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().orderId);",
                  "pm.test(\"Order saved as PENDING\", function () { pm.expect(pm.response.json().status).to.eql(\"PENDING\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05 Verify eventual stock 7",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productBaseUrl}}/products/{{productId}}",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "The test polls stock for up to 15 seconds. The response tab shows the initial response; Test Results shows whether eventual stock reached 7."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"testMode\") !== \"normal\") { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let attempts = 0;",
                  "function check(code, data) {",
                  " if (code === 200 && data.stock !== 7 && attempts++ < 15) {",
                  "  setTimeout(function () {",
                  "   pm.sendRequest(pm.variables.replaceIn(pm.request.url.toString()), function (err, res) {",
                  "    if (err) { pm.test(\"Stock polling reachable\", function () { pm.expect.fail(String(err)); }); return; }",
                  "    check(res.code, res.json());",
                  "   });",
                  "  }, 1000);",
                  "  return;",
                  " }",
                  " pm.test(\"Stock eventually equals 7\", function () { pm.expect(code).to.eql(200); pm.expect(data.stock).to.eql(7); });",
                  "}",
                  "check(pm.response.code, pm.response.json());"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
